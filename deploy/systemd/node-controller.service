[Unit]
Description=Dota 2 Arcade Node Controller
After=network-online.target d2core-manager.service
Wants=network-online.target d2core-manager.service

[Service]
Type=simple
User=arcade-node
Group=arcade-node
ExecStart=/opt/dota-arcade-node/current/node-controller run --config /etc/dota-arcade-node/node-controller.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
