[Unit]
Description=Fixed d2core v0.1.1 manager for Dota 2 Arcade Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arcade-node
Group=arcade-node
Environment=NODE_CONFIG=/etc/dota-arcade-node/node-controller.json
Environment=D2CORE_BIN=/opt/dota-arcade-node/current/d2core
ExecStart=/opt/dota-arcade-node/current/start-d2core-manager.sh
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
