# Example only. Use a dedicated development PostgreSQL database and secret.
PLATFORM_ENV=development
PLATFORM_DATABASE_URL=postgres://DEV_USER:DEV_PASSWORD@127.0.0.1:5432/dota_arcade_dev?sslmode=disable
PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:8080
PLATFORM_LISTEN_ADDR=127.0.0.1:8080
# Required explicit deployment choice; replace this placeholder with a positive integer.
# Independent of every GamePreset.max_players.
PLATFORM_MAX_PARTY_SIZE=REPLACE_WITH_POSITIVE_INTEGER
