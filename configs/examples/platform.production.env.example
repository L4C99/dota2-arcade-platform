# Example only. Keep real values outside the repository and deployment source tree.
PLATFORM_ENV=production
PLATFORM_DATABASE_URL=postgres://PROD_USER:PROD_PASSWORD@DB_HOST:5432/dota_arcade_prod?sslmode=verify-full
PLATFORM_PUBLIC_ORIGIN=https://platform.example.org
PLATFORM_LISTEN_ADDR=127.0.0.1:8080
